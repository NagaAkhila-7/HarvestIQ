# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,https://harvestiq-nu.vercel.app,http://127.0.0.1:5173
FRONTEND_URL=https://harvestiq-nu.vercel.app

# Database & Security
MONGO_URI=mongodb://127.0.0.1:27017/harvestiq
JWT_ACCESS_SECRET=harvestiq_super_secret_access_key_2026_safe
JWT_REFRESH_SECRET=harvestiq_super_secret_refresh_key_2026_safe
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_REMEMBER_ME=30d
COOKIE_SECRET=harvestiq_cookie_secret_key_2026

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Brevo HTTPS Transactional Email API Integration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=harvestiq.sender@gmail.com
